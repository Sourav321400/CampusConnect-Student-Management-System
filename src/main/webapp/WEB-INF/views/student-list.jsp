<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.List,edu.campusconnect.model.Student" %>
<%! private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% List<Student> students=(List<Student>)request.getAttribute("students");String message=request.getParameter("message"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>CampusConnect | Students</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body>
<header class="topbar"><div class="brand">Campus<span>Connect</span></div><div class="top-note">Student Management System</div></header><main class="container">
<section class="heading-row"><div><p class="eyebrow">STUDENT DIRECTORY</p><h1>Student Records</h1><p class="muted">Manage student information in one place.</p></div><a class="button" href="<%=request.getContextPath()%>/students?action=new">+ Add Student</a></section>
<% if("added".equals(message)){ %><div class="notice">Student added successfully.</div><% } if("updated".equals(message)){ %><div class="notice">Student updated successfully.</div><% } if("deleted".equals(message)){ %><div class="notice">Student deleted successfully.</div><% } %>
<section class="panel"><div class="panel-title"><h2>All Students</h2><span class="count"><%=students==null?0:students.size()%> records</span></div>
<% if(students==null||students.isEmpty()){ %><div class="empty-state"><h3>No student records yet</h3><p>Add the first student to get started.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Course</th><th>Phone</th><th>Actions</th></tr></thead><tbody>
<% for(Student s:students){ %><tr><td>#<%=s.getStudentId()%></td><td class="student-name"><%=esc(s.getName())%></td><td><%=esc(s.getEmail())%></td><td><span class="course-tag"><%=esc(s.getCourse())%></span></td><td><%=esc(s.getPhone())%></td><td class="actions"><a class="text-link" href="<%=request.getContextPath()%>/students?action=edit&id=<%=s.getStudentId()%>">Edit</a><form method="post" action="<%=request.getContextPath()%>/students" onsubmit="return confirm('Delete this student record?');"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=s.getStudentId()%>"><button class="delete-link" type="submit">Delete</button></form></td></tr><% } %>
</tbody></table></div><% } %></section><p class="footer-note">CampusConnect · Academic practical project</p></main></body></html>
