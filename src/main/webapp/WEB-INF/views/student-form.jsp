<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="edu.campusconnect.model.Student" %>
<%! private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% Student s=(Student)request.getAttribute("student");boolean editing=s!=null&&s.getStudentId()>0;String error=(String)request.getAttribute("error");String name=s==null?"":s.getName(),email=s==null?"":s.getEmail(),course=s==null?"":s.getCourse(),phone=s==null?"":s.getPhone();int id=s==null?0:s.getStudentId(); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>CampusConnect | Student Form</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body>
<header class="topbar"><div class="brand">Campus<span>Connect</span></div><div class="top-note">Student Management System</div></header><main class="container narrow"><a class="back-link" href="<%=request.getContextPath()%>/students">← Back to student records</a><section class="panel form-panel"><p class="eyebrow">STUDENT DETAILS</p><h1><%=editing?"Edit Student":"Add Student"%></h1><p class="muted">Enter the required information below.</p>
<% if(error!=null){ %><div class="error"><%=esc(error)%></div><% } %><form method="post" action="<%=request.getContextPath()%>/students" class="student-form"><input type="hidden" name="action" value="<%=editing?"update":"insert"%>"><% if(editing){ %><input type="hidden" name="id" value="<%=id%>"><% } %>
<label>Full name <span>*</span><input name="name" required maxlength="100" value="<%=esc(name)%>" placeholder="e.g. Aditi Sharma"></label><label>Email address <span>*</span><input type="email" name="email" required maxlength="150" value="<%=esc(email)%>" placeholder="student@example.com"></label><label>Course <span>*</span><input name="course" required maxlength="100" value="<%=esc(course)%>" placeholder="e.g. MCA"></label><label>Phone number<input name="phone" maxlength="20" value="<%=esc(phone)%>" placeholder="Optional contact number"></label><div class="form-actions"><button class="button" type="submit"><%=editing?"Save Changes":"Add Student"%></button><a class="cancel-link" href="<%=request.getContextPath()%>/students">Cancel</a></div></form></section></main></body></html>
